[Unit]
Description=HRMS backend staging
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hrmsdeploy
Group=hrmsdeploy
WorkingDirectory=/srv/hrms/staging/backend/current
EnvironmentFile=/srv/hrms/staging/shared/backend.env
ExecStart=/srv/hrms/staging/backend/current/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
